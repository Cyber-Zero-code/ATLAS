# Project ATLAS — External Linux Execution Gateway Environment Template
# SECURITY RULE: NEVER supply SUPABASE_SERVICE_ROLE_KEY to this gateway.
# Populate all required values on the target host; leave optional features empty.

# Loopback or interface IP the gateway HTTP server binds to (use 127.0.0.1 behind Caddy)
GATEWAY_HOST=
# TCP port the gateway listens on locally (defaults to 8443)
GATEWAY_PORT=
# Optional filesystem path to a TLS certificate PEM if terminating TLS directly in Node
GATEWAY_TLS_CERT_PATH=
# Optional filesystem path to a TLS private key PEM if terminating TLS directly in Node
GATEWAY_TLS_KEY_PATH=
# Allowed browser origin for CORS requests from the ATLAS frontend
GATEWAY_CORS_ORIGIN=

# Supabase project URL used for user membership verification
SUPABASE_URL=
# Supabase public anon key paired with the caller's AAL2 Bearer JWT (never use service_role)
SUPABASE_ANON_KEY=
# Expected Supabase JWT issuer URL (typically <SUPABASE_URL>/auth/v1)
SUPABASE_JWT_ISSUER=
# Expected JWT audience claim (defaults to authenticated)
SUPABASE_JWT_AUDIENCE=
# Supabase JWKS endpoint URL for asymmetric RS256/ES256 JWT verification
SUPABASE_JWKS_URL=
# Optional inline JWKS JSON string alternative when remote JWKS fetch is disabled
SUPABASE_JWKS_JSON=
# Optional HS256 JWT verification secret for self-hosted HS256 Supabase only (generate on VM if needed)
SUPABASE_JWT_HS256_SECRET=

# Comma-separated target IPv4/CIDR or domain suffixes allowed for active scans (empty fails closed)
GATEWAY_TARGET_ALLOWLIST=
# Writable sandbox directory for temporary PCAP uploads and datasets (use /var/lib/atlas-gateway with systemd)
GATEWAY_WORK_DIR=
# Maximum concurrent diagnostic/analysis worker jobs (1 to 16; defaults to 4)
GATEWAY_MAX_CONCURRENT_JOBS=
# Maximum uploaded PCAP size in bytes (minimum 65536; defaults to 10485760)
GATEWAY_MAX_PCAP_BYTES=

# AlienVault OTX API key for subscribed pulse polling (leave empty to keep OTX disabled)
OTX_API_KEY=
# Abuse.ch Auth-Key for ThreatFox, URLhaus, and Feodo feeds (leave empty to disable)
ABUSECH_AUTH_KEY=
# Base HTTPS URL of a MISP instance you control (requires MISP_API_KEY)
MISP_URL=
# MISP automation API key paired with MISP_URL (leave empty to disable)
MISP_API_KEY=
# Base HTTPS API root URL of an approved TAXII 2.1 server (leave empty to disable)
TAXII_API_ROOT=
# Optional TAXII 2.1 collection ID; if empty, uses the first readable collection
TAXII_COLLECTION_ID=

# Domain name terminated over HTTPS by Caddy (the domain you configured during DNS setup)
ATLAS_GATEWAY_DOMAIN=

# Optional external Python/ONNX vision inference endpoint for camera face and person analytics
CAMERA_ANALYTICS_URL=
# Optional Bearer API key for authenticating to the external camera vision analytics worker
CAMERA_ANALYTICS_API_KEY=
