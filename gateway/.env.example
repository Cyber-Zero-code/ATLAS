# Project ATLAS — External Linux Execution Gateway Configuration
# SECURITY RULE: NEVER supply SUPABASE_SERVICE_ROLE_KEY to this gateway!
# Authentication & organisation membership are resolved strictly using the
# caller's verified AAL2 Supabase user Bearer JWT + public SUPABASE_ANON_KEY.

GATEWAY_HOST="127.0.0.1"
GATEWAY_PORT="8443"

# Optional TLS certificate paths for native HTTPS termination (recommended outside loopback/reverse proxy)
GATEWAY_TLS_CERT_PATH=""
GATEWAY_TLS_KEY_PATH=""

# Allowed CORS origin for the ATLAS frontend
GATEWAY_CORS_ORIGIN="https://your-atlas-frontend.example"

# Supabase Auth & RLS Membership Lookup (NO service_role key!)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_JWT_ISSUER="https://your-project.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"

# Cryptographic JWT verification (provide JWKS URL, static JWKS JSON, OR HS256 secret ONLY for self-hosted HS256 Supabase)
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWKS_JSON=""
SUPABASE_JWT_HS256_SECRET=""

# Explicit Target Network Allowlist (comma-separated IPv4/CIDR or domain suffixes; fail-closed if empty)
# Loopback (127.0.0.0/8, ::1) and cloud metadata (169.254.0.0/16) are ALWAYS blocked regardless of allowlist.
GATEWAY_TARGET_ALLOWLIST="192.168.10.0/24,10.20.0.0/22"

# Isolated temporary workspace & concurrency bounds
GATEWAY_WORK_DIR="/tmp/atlas-worker-sandbox"
GATEWAY_MAX_CONCURRENT_JOBS="4"
GATEWAY_MAX_PCAP_BYTES="10485760"
